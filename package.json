{
  "name": "jegors-dorofejevs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:test": "node scripts/build-test.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:articles": "node scripts/test-articles.mjs",
    "test:authoring": "playwright test --config=playwright.authoring.config.ts",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "wrangler pages dev out",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "deploy:pages": "npm run build:pages && wrangler pages deploy out --branch main"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
